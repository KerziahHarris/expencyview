/build*
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json


# Widget Preview related
.widget_preview/

# Editor files from the C/C++ Runner extension (not used by this project)
.vscode/c_cpp_properties.json
.vscode/settings.json

# This is a web-only app. Flutter tools sometimes regenerate small helper
# files for other platforms; never commit them.
/android/
/ios/
/macos/
